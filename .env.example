# ============================================================
# CSE 7x24 自动排班系统 —— 环境变量模板
# 复制为 .env 后按需修改：cp .env.example .env
# ============================================================

# ---------- 运行环境 ----------
APP_ENV=production
APP_TIMEZONE=Asia/Shanghai

# ---------- 对外访问 ----------
# 浏览器访问端口（宿主机）；BIND_IP 留空表示监听所有网卡
APP_PORT=3005
BIND_IP=

# ---------- 数据库 ----------
POSTGRES_DB=cse_scheduler
POSTGRES_USER=cse
# 务必改成足够长的随机字符串
POSTGRES_PASSWORD=CHANGE_THIS_TO_A_LONG_RANDOM_PASSWORD
DATABASE_URL=postgresql+psycopg://cse:CHANGE_THIS_TO_A_LONG_RANDOM_PASSWORD@postgres:5432/cse_scheduler

# ---------- Redis（Celery 异步任务） ----------
REDIS_URL=redis://redis:6379/0

# ---------- JWT ----------
# 务必改成足够长的随机字符串（泄露会导致任何人可伪造登录令牌）
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET

# ---------- 初始管理员 ----------
# 首次初始化（users 表为空）时创建 admin 账号使用的密码；不填则用内置默认值
ADMIN_INITIAL_PASSWORD=CHANGE_THIS_TOO

# ---------- 求解参数（缺省值，实际以「规则配置」页为准） ----------
SOLVER_TIME_LIMIT=120
MINIMUM_REST_HOURS=11
MAX_CONSECUTIVE_WORK_DAYS=7
MAX_CONSECUTIVE_NIGHTS=3
NIGHT_FORCED_REST_DAYS=3

# ---------- 排班周期模式 ----------
# 26_TO_25：周期 = 上月 26 日 ~ 本月 25 日
IMPORT_PERIOD_MODE=26_TO_25

# ---------- 邮件通知（可选，未启用可留空） ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=CSE Scheduler <noreply@example.com>
