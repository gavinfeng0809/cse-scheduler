*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---------- Node / 前端 ----------
node_modules/
dist/
.vite/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

